load_module modules/ngx_http_stats_prom_module.so;

events {
    worker_connections 1024;
}

http {
    # Shared memory size for prometheus metrics (default: 1m)
    # prometheus_metrics_shm_size 2m;

    server {
        listen       80;
        server_name  example.com;

        location / { return 200 "ok"; }
        location /t { return 400 "not ok"; }
        location /proxy { proxy_pass http://test_backend/backend; }
    }

    server {
        listen       8081;
        server_name  api.example.com;

        location / { return 200 "api ok"; }
        location /slow {
            proxy_pass http://127.0.0.1:8082;
        }
    }

    server {
        listen       8082;
        server_name  _;
        limit_rate   1;

        location / {
            return 200 ".\n";
        }
    }

    upstream test_backend {
        server 127.0.0.1:80;
    }

    server {
        listen       9100;
        server_name  _;

        # Restrict access to internal / monitoring networks
        # allow 10.0.0.0/8;
        # allow 127.0.0.1;
        # deny  all;

        location /metrics {
            prometheus_metrics;
        }

        location / {
            return 404;
        }
    }
}
